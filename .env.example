# Copy to .env and fill in what you need. Everything is optional.
#
# API keys (OpenRouter, SendGrid, Pushover) are easiest to set in the app under Settings, which
# stores them in the database. Values here are used as a fallback; a key saved in Settings wins.

# Enables the "Summarize" button. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Default model for summaries (can also be changed in Settings). "openrouter/auto" lets OpenRouter pick.
OPENROUTER_MODEL=openrouter/auto

# Automations: "Send to email" action via SendGrid. SENDGRID_FROM must be a verified sender in your SendGrid account.
SENDGRID_API_KEY=
SENDGRID_FROM=

# Automations: "Push notification" action via Pushover. Create an application at https://pushover.net/apps/build
# for the token; the user key is shown on your Pushover dashboard.
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=

# Set to require a password before the app can be used (recommended if it's reachable from the internet).
APP_PASSWORD=

# Where the SQLite database lives. Defaults to ./data/reader.db
# DATABASE_PATH=./data/reader.db

# Set to 1 to turn off the background feed refresher.
# DISABLE_SCHEDULER=1
